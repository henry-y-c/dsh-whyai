{
  "name": "dsh-whyai",
  "version": "0.3.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henry-y-c/dsh-whyai.git"
  },
  "homepage": "https://github.com/henry-y-c/dsh-whyai#readme",
  "bugs": {
    "url": "https://github.com/henry-y-c/dsh-whyai/issues"
  },
  "description": "面向 DeepSeek Harness 的安全受限 WhyAI CLI 工具插件",
  "author": "花辣子米",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "whyai",
    "ai-agent",
    "cli",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "client": { "platform": "web" },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:composition": "node tests/real-composition.mjs",
    "verify": "npm run build && npm run typecheck && npm test",
    "verify:release": "npm run verify && npm run test:composition && npm run pack:smoke",
    "pack:smoke": "node tests/pack-smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify:release"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT"
}
